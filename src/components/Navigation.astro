---
import Logo from './Logo.astro'
import { DarkMode } from 'accessible-astro-components'
import { LauncherTrigger } from 'accessible-astro-launcher'
import { Icon } from 'astro-icon/components'
import themeConfig from '@theme-config'

/**
 * Navigation Component
 *
 * @description A minimal header: logo/title on the left, the light/dark
 * chooser and the accessible launcher menu on the right. Site navigation
 * lives in the launcher (built from theme.config navigation items).
 */
---

<div id="main-navigation" class="py-8">
  <div class="container">
    <div class="nav-bar">
      <Logo />
      <ul class="nav-actions">
        {
          themeConfig.navigation.darkmode && (
            <li class="type-icon animate-rotate">
              <DarkMode>
                <Icon aria-hidden="true" name="lucide:moon" slot="light" />
                <Icon aria-hidden="true" name="lucide:sun" slot="dark" />
              </DarkMode>
            </li>
          )
        }
        <li class="launcher-item">
          <LauncherTrigger launcherId="site-launcher" compact={true} gradientBorder={true} />
        </li>
      </ul>
    </div>
  </div>
</div>

<style lang="scss">
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
